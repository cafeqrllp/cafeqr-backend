{$CADDY_SITE_ADDRESS} {
	encode gzip

	# Real-time SSE streams at any depth (unbuffered, no proxy buffering)
	@sse path_regexp sse ^/api/.*/stream.*$
	handle @sse {
		reverse_proxy backend:8080 {
			flush_interval -1
		}
	}

	# REST APIs with keepalive connection pooling & automatic retry on closed sockets
	handle /api/* {
		reverse_proxy backend:8080 {
			transport http {
				keepalive 15s
				keepalive_idle_conns 100
			}
			lb_try_duration 3s
			lb_try_interval 100ms
		}
	}

	handle /actuator/health {
		reverse_proxy backend:8080
	}

	handle /actuator/* {
		respond "Forbidden" 403
	}

	handle {
		respond "Not Found" 404
	}
}

{$CADDY_REDIRECT_SITE_ADDRESS} {
	redir {$CADDY_CANONICAL_ORIGIN}{uri} permanent
}
